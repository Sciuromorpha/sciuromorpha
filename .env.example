# ==========================================
# Sciuromorpha Phase 1 (MVP) Configuration
# ==========================================

# PostgreSQL (Single Source of Truth)
DATABASE_URL=postgres://sciuromorpha:sciuromorpha@127.0.0.1:5432/sciuromorpha

# NATS JetStream Control Plane
NATS_URL=nats://127.0.0.1:4222

# Meilisearch Full-Text Index (keep private to sciuromorpha-core)
MEILI_URL=http://127.0.0.1:7700
MEILI_API_KEY=replace-with-master-or-private-admin-key

# Shared Hot Staging Area (Claim Check Pattern, 2-level SHA-256 sharded)
STAGING_DIR=/mnt/staging

# Local ZFS Hot Archive Backend (`zfs-hot` driver = `local_fs`)
ZFS_ARCHIVE_DIR=/mnt/zfs-hot

# Core HTTP Gateway & Dev Auth Options
CORE_BIND_ADDR=0.0.0.0:3000
DEV_OWNER_MODE=true
# ADMIN_BEARER_TOKEN=optional-static-admin-token

# External CLI Binaries for Workers (optional overrides)
# YT_DLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
